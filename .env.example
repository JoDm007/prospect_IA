# ─────────────────────────────────────────────────────────
#  CibleNet — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs réelles
#  Ne jamais committer .env sur Git !
# ─────────────────────────────────────────────────────────

# ── Groq API ──────────────────────────────────────────────
# Clé gratuite sur : https://console.groq.com
GROQ_API_KEY_1=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY_2=gsk_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# ── Discord Webhook ───────────────────────────────────────
# Serveur Discord → Paramètres salon → Intégrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXXX/YYYYYYYYYY

# ── Gmail (SMTP) ──────────────────────────────────────────
# 1. Activer vérification en 2 étapes sur myaccount.google.com
# 2. Sécurité → Mots de passe des applications → Générer
# 3. Coller le mot de passe 16 caractères ci-dessous
GMAIL_SENDER=ameviparfait95@gmail.com
GMAIL_APP_PASSWORD=pomxtolcvdocstrj
GMAIL_RECIPIENT=datemassejoseph@gmail.com

# ── Twilio — WhatsApp Sandbox ─────────────────────────────
# Compte gratuit sur : https://twilio.com
# Dashboard → Account SID + Auth Token
# Messaging → Try WhatsApp → rejoindre le sandbox depuis ton téléphone
# (envoyer "join <code>" au +14155238886 sur WhatsApp)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+22890000000

# ── Twilio — SMS ──────────────────────────────────────────
# Numéro Twilio gratuit dans le dashboard (Phone Numbers)
TWILIO_SMS_FROM=+1XXXXXXXXXX
TWILIO_SMS_TO=+22890000000

# ── Google Sheets (optionnel — backup) ───────────────────
# ID dans l'URL : https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

