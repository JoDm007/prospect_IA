# ─────────────────────────────────────────────────────────
#  Yas Prospect Copilot — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs réelles
#  Ne jamais committer .env sur Git !
# ─────────────────────────────────────────────────────────

# ── Groq API ──────────────────────────────────────────────
# Obtenir une clé gratuite sur : https://console.groq.com
# Configurer 2 clés pour le fallback automatique
GROQ_API_KEY_1=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY_2=gsk_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# ── Discord Webhook ───────────────────────────────────────
# Créer un webhook : Serveur Discord → Paramètres du salon
# → Intégrations → Webhooks → Nouveau webhook → Copier l'URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXXX/YYYYYYYYYY

# ── Google Sheets (optionnel — backup J3) ─────────────────
# L'ID se trouve dans l'URL du sheet :
# https://docs.google.com/spreadsheets/d/<ID_ICI>/edit
GOOGLE_SHEETS_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# ── Chemin base de données (optionnel — défaut : data/prospects.db) ──
# DB_PATH=data/prospects.db
